# Configuración del cliente
CLIENT_ID=transcoder-node-01
CLIENT_NAME="Transcodificador Principal"
CLIENT_LOCATION="Datacenter A - Rack 3"

# Backend Quarkus
BACKEND_URL=http://localhost:8080
API_KEY=your-api-key-here

# Servidor local
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
METRICS_PORT=9090

# Logging
RUST_LOG=info
LOG_FILE=logs/transcoder.log

# Performance
MAX_CHANNELS=10
WORKER_THREADS=4
BUFFER_SIZE_MB=256

# FFmpeg
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Networking
DEFAULT_SRT_LATENCY=120
DEFAULT_UDP_TTL=32

# Monitoring
HEARTBEAT_INTERVAL=30
STATS_REPORT_INTERVAL=10
CONFIG_SYNC_INTERVAL=300

# Features
ENABLE_METRICS=true
ENABLE_AUTO_START=true
ENABLE_CONFIG_BACKUP=true