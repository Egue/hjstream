[Unit]
Description=CATV Transcoder Client
Documentation=https://github.com/Eguee/hjstream
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=transcoder
Group=transcoder

# Directorio de trabajo
WorkingDirectory=/opt/hjstream

# Binario
ExecStart=/opt/hjstream/bin/hjstream

# Recargar configuración
ExecReload=/bin/kill -HUP $MAINPID

# Pre-start: verificar configuración
ExecStartPre=/opt/hjstream/scripts/pre-start-check.sh

# Post-stop: cleanup
ExecStopPost=/opt/hjstream/scripts/post-stop-cleanup.sh

# Reinicio automático
Restart=always
RestartSec=10s

# Timeout
TimeoutStartSec=60s
TimeoutStopSec=30s

# Recursos
# CPU
CPUQuota=400%
CPUWeight=100

# Memoria
MemoryMax=8G
MemoryHigh=6G

# Tareas
TasksMax=4096

# Archivos
LimitNOFILE=65536
LimitNPROC=4096

# Core dumps
LimitCORE=infinity

# Variables de entorno
Environment="RUST_LOG=info"
Environment="RUST_BACKTRACE=1"
EnvironmentFile=/opt/hjstream/.env

# Seguridad
# NoNewPrivileges=true
# PrivateTmp=true
# ProtectSystem=strict
# ProtectHome=true
# ReadWritePaths=/opt/hjstream/logs /opt/hjstream/config

# Capabilities necesarias para networking
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hjstream

# Journald
# Mantener últimas 100MB de logs
# RuntimeMaxUse=100M

[Install]
WantedBy=multi-user.target