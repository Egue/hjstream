[Unit]
Description=hjstream Service
After=network-online.target
Wants=network-online.target
Documentation=https://github.com/Egue/hjstream

[Service]
Type=simple
User=root
WorkingDirectory=/opt/hjstream
ExecStart=/usr/local/bin/hjstream

# Reinicio automático
Restart=always
RestartSec=5

# Limites de recursos
LimitNOFILE=1048576
LimitNPROC=512

# Variables de entorno
Environment="RUST_LOG=info"

# Seguridad
PrivateTmp=false
NoNewPrivileges=false

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hjstream

[Install]
WantedBy=multi-user.target
