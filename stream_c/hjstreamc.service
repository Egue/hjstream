[Unit]
Description=Multi-hjstreamc for CATV-2 Modulators
Documentation=https://github.com/Egue/hjstream
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=streaming
Group=streaming

# Directorio de trabajo
WorkingDirectory=/opt/hjstreamc

# Comando de ejecución
ExecStart=/opt/hjstreamc/stream_relay_ts /opt/hjstreamc/config.txt

# Reinicio automático
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hjstreamc

# Límites de recursos
LimitNOFILE=65536
LimitNPROC=4096
LimitMEMLOCK=infinity

# Seguridad
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hjstreamc

# Red
RestrictAddressFamilies=AF_INET AF_INET6

# Optimización de rendimiento
Nice=-10
IOSchedulingClass=realtime
IOSchedulingPriority=0
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=50

[Install]
WantedBy=multi-user.target
