[Unit]
Description=Multi-hjstreamc for CATV-2 Modulators
After=network.target

# Límites de reinicio
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=streaming
Group=streaming

# Directorio de trabajo
WorkingDirectory=/opt/hjstreamc

# Comando de ejecución
ExecStart=/opt/hjstreamc/stream_relay_ts /opt/hjstreamc/config.txt

# Reinicio en fallo para evitar bucles de reinicio infinito
Restart=on-failure
RestartSec=5
TimeoutStartSec=30

# Verificar que exista y sea legible el archivo de configuración antes de iniciar
ExecStartPre=/usr/bin/test -f /opt/hjstreamc/config.txt
ExecStartPre=/usr/bin/test -r /opt/hjstreamc/config.txt
ExecStartPre=/usr/bin/runuser -u streaming -- /usr/bin/test -r /opt/hjstreamc/config.txt

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hjstreamc

# Límites de recursos
LimitNOFILE=65536
LimitNPROC=4096
LimitMEMLOCK=infinity

# Seguridad
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hjstreamc

# Red
RestrictAddressFamilies=AF_INET AF_INET6

# Optimización de rendimiento
Nice=-10
IOSchedulingClass=realtime
IOSchedulingPriority=0
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=50

[Install]
WantedBy=multi-user.target
